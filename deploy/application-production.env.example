SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_REPOSITORY_MODE=mysql
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/enterprise_ai_cockpit?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=replace-me
MYSQL_PASSWORD=replace-me
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0
QUARTZ_THREAD_COUNT=2
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
LLM_ENABLED=true
LLM_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-me
LLM_MODEL=deepseek-v4-flash
VECTOR_ENABLED=true
VECTOR_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/enterprise_ai_cockpit_vector
VECTOR_DATABASE_USER=replace-me
VECTOR_DATABASE_PASSWORD=replace-me
EMBEDDING_MODE=local
EMBEDDING_DIMENSIONS=1536
MCP_ENABLED=true
MCP_NODE_COMMAND=/usr/bin/node
MCP_WEATHER_SERVER=mcp-servers/weather-mcp-server.js
MCP_REQUEST_TIMEOUT=20s
ACTION_PASSWORD=replace-with-a-strong-operation-password
ACTION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACTION_TOKEN_TTL_MINUTES=30
